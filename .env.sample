
DATABASE_URL=postgresql://jepc:@localhost:5432/lms_db
# Máximo de conexiones del pool de Postgres por instancia del backend
DATABASE_POOL_MAX=10
JWT_SECRET=global-password
JWT_REFRESH_SECRET=global-password-refresh
JWT_ACTION_SECRET=global-password-action
PORT=4000
URL_FRONTEND=http://localhost:3000
NODE_ENV=dev

# VERIFICATION EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jhonesau2003@gmail.com
SMTP_PASS=xxxxxxxxxx

# Storage Driver: "local" | "cloudinary" | "s3"
STORAGE_DRIVER=cloudinary

# Cloudinary (mantener configurado mientras existan imágenes históricas)
CLOUDINARY_CLOUD_NAME=xxxxxxd
CLOUDINARY_API_KEY=xxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# S3 (requerido si STORAGE_DRIVER=s3; lectura pública solo bajo public/)
S3_BUCKET=especializaciones-global
S3_REGION=us-east-1

# Credenciales AWS para este backend sin rol de ejecución. El SDK las lee de
# process.env; deja las tres vacías si usas un rol AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales
AWS_SESSION_TOKEN=

YOUTUBE_API_KEY=xxxxxxxxxxxxxx

# Admin seed (requerido para npm run db:seed:admin y para el CMD del Dockerfile)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Mercado Pago (payments-v2 Bricks)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx
MERCADOPAGO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Culqi (payments-v2) - Panel de Integración -> Development / API Keys
CULQI_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
CULQI_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx

# Cloudflare Turnstile (anti-bot en register/login/forgot-password/reset-password)
# Secret key del widget, dashboard.cloudflare.com > Turnstile
TURNSTILE_SECRET_KEY=xxxxxxxxxxxxxxxx
# Hostnames del widget y origenes de navegador autorizados para auth, separados por coma
TURNSTILE_ALLOWED_HOSTNAMES=localhost

# PayPal (payments-v2). PAYPAL_MODE: sandbox | live
# PAYPAL_WEBHOOK_ID: id del webhook creado en developer.paypal.com apuntando a
# /api/payments-v2/paypal/webhook (evento PAYMENT.CAPTURE.COMPLETED)
PAYPAL_CLIENT_ID=xxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxx
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=xxxxxxxxxx

# Stripe (payments legacy)
STRIPE_SECRET_KEY=xxxxxxxxxx
