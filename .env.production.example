# =============================================================
# lms-backend — variables de entorno para Docker (production)
# =============================================================
# INSTRUCCIONES:
#   1. Copia este archivo a .env.production:
#        cp .env.production.example .env.production
#   2. Rellena cada valor marcado con CHANGE_ME.
#   3. NO commitees .env.production (esta en .gitignore).
# =============================================================

# ---------- Runtime de Node ----------
NODE_ENV=production
PORT=4000
# Diagnóstico temporal del límite por IP. Actívalo solo durante la verificación
# de dos redes distintas y desactívalo al terminar. Solo admite GET públicos.
RATE_LIMIT_IP_DIAGNOSTICS=false
RATE_LIMIT_IP_DIAGNOSTIC_PATH=/api/sliders

# ---------- App ----------
# ⚠️ Dentro de Docker, "postgres" es el nombre del servicio
# en docker-compose.yml, NO uses "localhost" aqui.
DATABASE_URL=postgresql://lms_user:CHANGE_ME@postgres:5432/lms_db
# Máximo de conexiones del pool de Postgres por instancia del backend. Si corres
# varias réplicas, multiplica este valor x número de réplicas contra el límite
# real de Postgres (o usa un pooler tipo PgBouncer).
DATABASE_POOL_MAX=10

# Generar con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACTION_SECRET=CHANGE_ME

# URL del frontend (para CORS y para construir links/URLs de retorno). En local: http://localhost:3000
URL_FRONTEND=http://localhost:3000

# Cookies JWT: `secure: true` solo cuando hay HTTPS.
# - false  → se accede por HTTP plano (ej. http://IP_VPS:3000)
# - true   → hay HTTPS (ej. https://tu-dominio.com con cert)
COOKIE_SECURE=false

# ---------- Storage ----------
# Opciones: "local" | "cloudinary" | "s3"
STORAGE_DRIVER=cloudinary

# Mantener estas credenciales mientras existan imágenes en Cloudinary.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Completar estos valores al seleccionar STORAGE_DRIVER=s3. Las imágenes
# se leen directamente desde S3 bajo el prefijo public/.
# Dejarlos vacíos con STORAGE_DRIVER=cloudinary.
S3_BUCKET=
S3_REGION=

# Credenciales AWS para este backend sin rol de ejecución. El SDK las lee de
# process.env; deja las tres vacías si usas un rol AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Solo para credenciales temporales
AWS_SESSION_TOKEN=

# ---------- SMTP (envio de emails) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME

# ---------- YouTube Data API v3 ----------
# Consola: https://console.cloud.google.com/apis/credentials
# Habilita "YouTube Data API v3" y crea una API key.
YOUTUBE_API_KEY=CHANGE_ME

# ---------- Mercado Pago (Bricks) ----------
MERCADOPAGO_ACCESS_TOKEN=CHANGE_ME
MERCADOPAGO_WEBHOOK_SECRET=CHANGE_ME

# ---------- Culqi ----------
# Panel de Integración de Culqi (mismo usuario/contraseña que CulqiPanel) -> Development / API Keys
CULQI_SECRET_KEY=CHANGE_ME
CULQI_PUBLIC_KEY=CHANGE_ME

# ---------- Cloudflare Turnstile ----------
# Secret key del widget, dashboard.cloudflare.com > Turnstile
TURNSTILE_SECRET_KEY=CHANGE_ME
# Hostnames del widget y origenes de navegador autorizados para auth, separados por coma.
# Usa solo dominios del frontend; sin protocolo ni rutas. No incluyas el host de la API.
TURNSTILE_ALLOWED_HOSTNAMES=escuelaglobal.net,www.escuelaglobal.net

# ---------- PayPal (payments-v2) ----------
# PAYPAL_MODE: sandbox | live
# PAYPAL_WEBHOOK_ID: id del webhook apuntando a /api/payments-v2/paypal/webhook
PAYPAL_CLIENT_ID=CHANGE_ME
PAYPAL_CLIENT_SECRET=CHANGE_ME
PAYPAL_MODE=live
PAYPAL_WEBHOOK_ID=CHANGE_ME

# ---------- Stripe (payments legacy) ----------
STRIPE_SECRET_KEY=CHANGE_ME

# =============================================================
# Variables de docker-compose (NO las usa NestJS, las consume
# el servicio `postgres` para inicializar la base de datos).
# Manten los valores sincronizados con DATABASE_URL.
# =============================================================
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lms_db
